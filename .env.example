# Used only by the explicit live-model check; ordinary tests need no API key.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

KAPY_DATABASE_SCHEMA=kapy_tmpv2
KAPY_VALKEY_NAMESPACE=kapy_tmpv2
# Shared by live publishing and Telegram draft refresh (seconds).
# KAPY_OUTPUT_FLUSH_INTERVAL=0.5
# Compose supplies internal service URLs to runtime; these are host-side defaults.
KAPY_DATABASE_URL=postgresql://kapy:kapy-local@127.0.0.1:55432/kapy
KAPY_VALKEY_URL=redis://127.0.0.1:56379/0
# KAPY_POSTGRES_PORT=55432
# KAPY_VALKEY_PORT=56379

# The HTTP plugin also serves the frontend at /app/.
# KAPY_HTTP_PORT=8000

# Compose starts this bot independently; no provider/model is created at startup.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional JSON list replaces the single TELEGRAM_CHAT_ID in Compose.
# KAPY_TELEGRAM_ALLOWED_CHAT_IDS=[123456]
# Optional initial fallback; /model in Telegram overrides it and persists the choice.
# KAPY_TELEGRAM_SESSION_TEMPLATE={"provider_id":"your-provider-uuid","model_name":"your-model"}
