# Copy to .env. Docker Compose reads it automatically; kapy does not.
# For direct CLI use: uv run --env-file .env kapy interface <http|telegram> serve
# Startup does not create providers/models. Configure them in /app/, then use
# Telegram /model <provider UUID> <model name> to set the saved bot default
# and update the current session.

# Shared configuration (Compose and direct CLI).
# Use the same PostgreSQL schema and Valkey namespace across both interfaces.
KAPY_DATABASE_SCHEMA=kapy_tmpv2
KAPY_VALKEY_NAMESPACE=kapy_tmpv2
# Live publication and Telegram draft refresh interval, in seconds.
# 0 publishes without batching; Telegram still limits draft refresh to 0.5s.
# KAPY_OUTPUT_FLUSH_INTERVAL=0.5

# Host-side connections for direct CLI and tests. Compose uses its internal
# postgres/valkey service URLs instead. If changing their published ports below,
# update these host-side URLs too.
KAPY_DATABASE_URL=postgresql://kapy:kapy-local@127.0.0.1:55432/kapy
KAPY_VALKEY_URL=redis://127.0.0.1:56379/0

# Compose host ports: PostgreSQL and Valkey bind to 127.0.0.1;
# HTTP binds to 0.0.0.0 and serves the frontend at /app/.
# KAPY_POSTGRES_PORT=55432
# KAPY_VALKEY_PORT=56379
# KAPY_HTTP_PORT also sets the listening port when using the direct HTTP CLI.
# KAPY_HTTP_PORT=8000

# Telegram credentials and access (Compose and direct CLI).
TELEGRAM_BOT_TOKEN=
# Compose-only shorthand for a single allowed chat.
TELEGRAM_CHAT_ID=
# Required for direct CLI. In Compose, this JSON list replaces TELEGRAM_CHAT_ID.
# KAPY_TELEGRAM_ALLOWED_CHAT_IDS=[123456]
# Optional initial fallback; use an existing provider UUID and model name.
# A saved /model choice overrides this template. Omit it to configure later.
# KAPY_TELEGRAM_SESSION_TEMPLATE='{"provider_id":"00000000-0000-0000-0000-000000000001","model_name":"your-model"}'

# Optional direct CLI settings (not forwarded by the current Compose file).
# Common process settings; durations are in seconds, heartbeat interval < timeout.
# KAPY_LOG_LEVEL=INFO
# KAPY_HEARTBEAT_INTERVAL=10
# KAPY_HEARTBEAT_TIMEOUT=60
# KAPY_REALTIME_OUTPUT=true

# HTTP: CLI flags override these values. Mount a built frontend directory at /app/.
# Without KAPY_HTTP_FRONTEND_DIST or --frontend-dist, no frontend is mounted.
# KAPY_HTTP_HOST=127.0.0.1
# KAPY_HTTP_FRONTEND_DIST=./frontend/dist
# KAPY_HTTP_SHUTDOWN_TIMEOUT=15

# Telegram: Bot API endpoint, long-poll timeout (1-50s), session recovery interval.
# KAPY_TELEGRAM_API_BASE=https://api.telegram.org
# KAPY_TELEGRAM_POLL_TIMEOUT=25
# KAPY_TELEGRAM_RECOVERY_INTERVAL=5

# Local state follows XDG: $XDG_STATE_HOME/kapy, or ~/.local/state/kapy.
# Telegram's independent SQLite defaults to plugins/telegram/telegram.sqlite3
# within that directory. An explicit database path must be absolute and is used
# by both `kapy interface telegram serve` and `kapy interface telegram db`.
# XDG_STATE_HOME=/absolute/path/to/state
# KAPY_TELEGRAM_DATABASE_PATH=/absolute/path/to/telegram.sqlite3
# Compose fixes XDG_STATE_HOME=/var/lib/kapy/state in separate interface volumes.

# Optional credentials for the explicit live-model check only:
# docker compose exec -T runtime python scripts/check_runtime.py
# Ordinary tests and interface startup need no model API key here; these variables
# do not configure the provider/model catalog used by the frontend or Telegram.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
