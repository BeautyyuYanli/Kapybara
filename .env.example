KAPY_COMPRESSION_RATIO=0.70
KAPY_KEEP_RECENT_RATIO=0.10
KAPY_MEDIA_MAX_BYTES=20971520
# Unset: enable Telegram when token exists. [] disables all frontend plugins.
# KAPY_TOOL_PLUGINS='["apply_patch"]'  # [] disables script plugins
# KAPY_FRONTENDS='["telegram"]'
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
KAPY_DATABASE_URL=postgresql://kapy:kapy-local@127.0.0.1:55432/kapy
KAPY_VALKEY_URL=redis://127.0.0.1:56379/0
KAPY_DATABASE_SCHEMA=kapy_state
KAPY_VALKEY_NAMESPACE=kapy_state
KAPY_CONTROL_URL=http://127.0.0.1:8000
KAPY_CONTROL_TOKEN=
KAPY_SESSION_SIGNING_KEY=
KAPY_MACHINE_ID=docker-machine
KAPY_MACHINE_TOKEN=
# Use the same machine id/token in the control plane's JSON mapping.
# Keep outer single quotes so uv --env-file preserves the JSON double quotes.
KAPY_MACHINE_TOKENS='{}'
