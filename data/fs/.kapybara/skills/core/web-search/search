#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.12"
# dependencies = ["httpx", "pydantic", "uvloop", "PyYAML"]
# ///

"""Run one or more Exa web searches and persist full results under `/tmp`.

- search focuses on highlights (max 4000 chars) as requested by owner.
- Caller must provide a unique `--out-dir` under `/tmp`.
"""

import argparse
import asyncio
import hashlib
import json
import os
import sys
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, TypeVar

import httpx
from pydantic import BaseModel, ConfigDict


MAX_SNIPPET_CHARS = 280
MAX_STDOUT_FIELD_CHARS = 120
MAX_STDOUT_DESCRIPTION_CHARS = 400
DEFAULT_CONCURRENCY = 16
REQUEST_TIMEOUT_SECONDS = 60.0
TMP_ROOT = Path("/tmp").resolve()
T = TypeVar("T")


class SearchJob(BaseModel):
    query: str
    out_path: Path


class ExaResult(BaseModel):
    model_config = ConfigDict(extra="ignore")
    title: str | None = None
    url: str | None = None
    highlights: list[str] | None = None
    score: float | None = None
    id: str | None = None
    publishedDate: str | None = None
    author: str | None = None


class ExaSearchPayload(BaseModel):
    model_config = ConfigDict(extra="ignore")
    results: list[ExaResult]


class CompactSearchResult(BaseModel):
    model_config = ConfigDict(extra="forbid")
    title: str
    url: str
    description: str
    highlights: list[str] | None = None


class SearchOutputPayload(BaseModel):
    model_config = ConfigDict(extra="forbid")
    query: str
    generated_at: str
    output_path: str
    result_count: int
    results: list[CompactSearchResult]
    error: str | None = None


class SearchSummaryRow(BaseModel):
    model_config = ConfigDict(extra="forbid")
    query: str
    result_count: int
    output_path: str
    results: list[dict[str, str]] | None = None
    error: str | None = None


def _normalize_whitespace(value: str) -> str:
    return " ".join(value.split())


def _as_clean_string(value: object) -> str:
    if isinstance(value, str):
        return value.strip()
    return ""


def _truncate(text: str, max_chars: int) -> str:
    if len(text) <= max_chars:
        return text
    return text[: max_chars - 3].rstrip() + "..."


def _utc_now_iso() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")


def _write_text_file(path: Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("w", encoding="utf-8") as f:
        f.write(content)


def _dump_model(payload: BaseModel | dict[str, Any]) -> str:
    data = payload.model_dump(exclude_none=True) if isinstance(payload, BaseModel) else payload
    return json.dumps(data, ensure_ascii=False, indent=2) + "\n"


def _assert_tmp_path(path: Path, label: str) -> None:
    resolved = path.resolve()
    try:
        resolved.relative_to(TMP_ROOT)
    except ValueError as exc:
        raise ValueError(f"{label} must be under /tmp: {path}") from exc


def _build_jobs(queries: list[str], out_dir: str) -> list[SearchJob]:
    base_dir = Path(out_dir).expanduser().resolve()
    _assert_tmp_path(base_dir, "Output directory")
    if base_dir.exists():
        raise ValueError(f"Output directory already exists: {base_dir}")
    base_dir.mkdir(parents=True, exist_ok=False)

    run_id = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S%f")
    jobs: list[SearchJob] = []
    for index, query in enumerate(queries):
        digest = hashlib.sha1(query.encode("utf-8")).hexdigest()[:8]
        out_path = base_dir / f"web_search_{run_id}_{index:03d}_{digest}.md"
        jobs.append(SearchJob(query=query, out_path=out_path))
    return jobs


def _format_search_output(raw_output: str, query: str, out_path: str) -> str:
    resolved_out_path = str(Path(out_path).resolve())
    generated_at = _utc_now_iso()

    try:
        payload = json.loads(raw_output)
        validated_payload = ExaSearchPayload.model_validate(payload)
    except Exception as exc:
        fallback = SearchOutputPayload(
            query=query,
            generated_at=generated_at,
            output_path=resolved_out_path,
            result_count=0,
            results=[],
            error=f"Invalid response: {exc}",
        )
        return _dump_model(fallback)

    compact_results: list[CompactSearchResult] = []
    for item in validated_payload.results:
        title = _as_clean_string(item.title) or "No Title"
        url = _as_clean_string(item.url) or ""
        highlights = item.highlights
        
        description = _truncate(_normalize_whitespace(" ".join(highlights)), MAX_STDOUT_DESCRIPTION_CHARS) if highlights else ""

        compact = CompactSearchResult(
            title=title,
            url=url,
            description=description,
            highlights=highlights or None,
        )
        compact_results.append(compact)

    output = SearchOutputPayload(
        query=query,
        generated_at=generated_at,
        output_path=resolved_out_path,
        result_count=len(compact_results),
        results=compact_results,
    )
    return _dump_model(output)


async def _run_search_job(
    client: httpx.AsyncClient,
    job: SearchJob,
    exa_key: str,
) -> SearchSummaryRow:
    headers = {
        "x-api-key": exa_key,
        "Content-Type": "application/json",
    }
    # Per owner instructions: search only return highlights, max char = 4000
    request_body = {
        "query": job.query,
        "type": "auto",
        "num_results": 10,
        "contents": {
            "highlights": {"max_characters": 4000}
        }
    }

    try:
        response = await client.post(
            "https://api.exa.ai/search",
            json=request_body,
            headers=headers,
            timeout=REQUEST_TIMEOUT_SECONDS,
        )
        response.raise_for_status()
        payload = ExaSearchPayload.model_validate(response.json())
        
        md_content = []
        compact_results = []
        for res in payload.results:
            # Metadata as YAML header
            meta = {
                "title": res.title or "No Title",
                "url": res.url or "",
                "publishedDate": res.publishedDate or "",
                "author": res.author or "",
                "score": res.score or 0.0,
                "id": res.id or "",
            }
            import yaml
            # Clean meta of None/empty if desired, but owner said YAML header
            yaml_header = "---\n" + yaml.dump(meta, allow_unicode=True, default_flow_style=False) + "---\n"
            
            highlights_text = "\n\n".join(res.highlights) if res.highlights else ""
            md_content.append(yaml_header + highlights_text)
            
            # For summary
            compact_results.append(CompactSearchResult(
                title=res.title or "No Title",
                url=res.url or "",
                description=_truncate(_normalize_whitespace(" ".join(res.highlights or [])), MAX_STDOUT_DESCRIPTION_CHARS),
                highlights=res.highlights,
            ))
            
        full_md = "\n\n---\n\n".join(md_content)
        _write_text_file(job.out_path, full_md)
        
        error = None
        result_count = len(compact_results)

    except Exception as exc:
        error = str(exc)
        result_count = 0
        compact_results = []
        _write_text_file(job.out_path, f"Error: {error}")

    summary = SearchSummaryRow(
        query=_truncate(job.query, MAX_STDOUT_FIELD_CHARS),
        result_count=result_count,
        output_path=str(job.out_path.resolve()),
        error=error,
    )
    if compact_results:
        summary.results = []
        for r in compact_results[:5]: # Limit results in stdout
            row = {
                "title": _truncate(r.title, MAX_STDOUT_FIELD_CHARS),
                "url": _truncate(r.url, MAX_STDOUT_FIELD_CHARS),
                "description": _truncate(r.description, MAX_STDOUT_DESCRIPTION_CHARS),
            }
            summary.results.append(row)
    return summary


async def _run_search_jobs(jobs: list[SearchJob], exa_key: str) -> list[SearchSummaryRow]:
    semaphore = asyncio.Semaphore(DEFAULT_CONCURRENCY)
    async with httpx.AsyncClient() as client:
        async def bounded(job: SearchJob) -> SearchSummaryRow:
            async with semaphore:
                return await _run_search_job(client, job, exa_key)
        return await asyncio.gather(*(bounded(job) for job in jobs))


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("queries", nargs="+")
    parser.add_argument("--out-dir", required=True)
    args = parser.parse_args()

    exa_key = os.environ.get("EXA_API_KEY")
    if not exa_key:
        print("Error: EXA_API_KEY not set", file=sys.stderr)
        sys.exit(1)

    try:
        jobs = _build_jobs(args.queries, args.out_dir)
        import uvloop
        uvloop.install()
        rows = asyncio.run(_run_search_jobs(jobs, exa_key))
        summary = {
            "generated_at": _utc_now_iso(),
            "total_queries": len(rows),
            "results": [r.model_dump(exclude_none=True) for r in rows],
        }
        sys.stdout.write(json.dumps(summary, ensure_ascii=False, indent=2) + "\n")
    except Exception as exc:
        print(f"Error: {exc}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
