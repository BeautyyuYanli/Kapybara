#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.12"
# dependencies = ["httpx", "pydantic", "uvloop", "PyYAML"]
# ///

"""Fetch one or more URLs via Exa API and persist full output under `/tmp`.

- fetch focuses on fulltext (markdown) without max character limits.
- Caller must provide a unique `--out-dir` under `/tmp`.
"""

import argparse
import asyncio
import json
import os
import sys
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, TypeVar

import httpx
from pydantic import BaseModel, ConfigDict


TMP_ROOT = Path("/tmp").resolve()
DEFAULT_CONCURRENCY = 16
REQUEST_TIMEOUT_SECONDS = 90.0
T = TypeVar("T")


class ExaContentResult(BaseModel):
    model_config = ConfigDict(extra="ignore")
    url: str | None = None
    title: str | None = None
    text: str | None = None
    id: str | None = None
    author: str | None = None
    publishedDate: str | None = None
    favicon: str | None = None
    image: str | None = None


class ExaContentsPayload(BaseModel):
    model_config = ConfigDict(extra="ignore")
    results: list[ExaContentResult]


class FetchManifestRow(BaseModel):
    model_config = ConfigDict(extra="forbid")
    index: int
    url: str
    status: str
    chars: int
    error: str | None = None
    markdown_path: str | None = None


class FetchManifest(BaseModel):
    model_config = ConfigDict(extra="forbid")
    generated_at: str
    output_dir: str
    content_dir: str
    total_urls: int
    ok_count: int
    error_count: int
    results: list[FetchManifestRow]


def _utc_now_iso() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")


def _dump_model(payload: BaseModel | dict[str, object]) -> str:
    data = payload.model_dump(exclude_none=True) if isinstance(payload, BaseModel) else payload
    return json.dumps(data, ensure_ascii=False, indent=2) + "\n"


def _write_text_file(path: Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("w", encoding="utf-8") as f:
        f.write(content)


def _assert_tmp_path(path: Path, label: str) -> None:
    resolved = path.resolve()
    try:
        resolved.relative_to(TMP_ROOT)
    except ValueError as exc:
        raise ValueError(f"{label} must be under /tmp: {path}") from exc


def _prepare_output_dir(out_dir: str) -> Path:
    output_dir = Path(out_dir).expanduser().resolve()
    _assert_tmp_path(output_dir, "Output directory")
    if output_dir.exists():
        raise ValueError(f"Output directory already exists: {output_dir}")
    output_dir.mkdir(parents=True, exist_ok=False)
    return output_dir


def _content_dir_from_output_dir(output_dir: Path) -> Path:
    return output_dir / "contents"


async def _fetch_urls(urls: list[str], exa_key: str) -> list[ExaContentResult]:
    headers = {
        "x-api-key": exa_key,
        "Content-Type": "application/json",
    }
    # Per owner instructions: fetch only return content (text/markdown), no max char limit.
    # Exa's "text" field returns markdown-formatted content by default now.
    request_body = {
        "urls": urls,
        "text": True
    }
    async with httpx.AsyncClient() as client:
        response = await client.post(
            "https://api.exa.ai/contents",
            json=request_body,
            headers=headers,
            timeout=REQUEST_TIMEOUT_SECONDS,
        )
        response.raise_for_status()
        payload = ExaContentsPayload.model_validate(response.json())
        return payload.results


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("urls", nargs="+")
    parser.add_argument("--out-dir", required=True)
    args = parser.parse_args()

    exa_key = os.environ.get("EXA_API_KEY")
    if not exa_key:
        print("Error: EXA_API_KEY not set", file=sys.stderr)
        sys.exit(1)

    try:
        output_dir = _prepare_output_dir(args.out_dir)
        content_dir = _content_dir_from_output_dir(output_dir)
        content_dir.mkdir(parents=True, exist_ok=True)

        import uvloop
        uvloop.install()
        results = asyncio.run(_fetch_urls(args.urls, exa_key))

        manifest_rows: list[FetchManifestRow] = []
        ok_count = 0
        for index, result in enumerate(results):
            url = result.url or f"Unknown URL {index}"
            # The "text" field from Exa is already in markdown format per changelog 2025-06-23.
            markdown = result.text or ""

            # Metadata as YAML header
            import yaml
            meta = {
                "title": result.title or "No Title",
                "url": url,
                "publishedDate": result.publishedDate or "",
                "author": result.author or "",
                "id": result.id or "",
            }
            yaml_header = "---\n" + yaml.dump(meta, allow_unicode=True, default_flow_style=False) + "---\n"
            full_content = yaml_header + markdown

            row = FetchManifestRow(
                index=index,
                url=url,
                status="ok" if markdown else "error",
                chars=len(full_content),
            )
            if markdown:
                ok_count += 1
                md_path = content_dir / f"item_{index:03d}.md"
                _write_text_file(md_path, full_content)
                row.markdown_path = str(md_path.resolve())
            manifest_rows.append(row)

        manifest = FetchManifest(
            generated_at=_utc_now_iso(),
            output_dir=str(output_dir.resolve()),
            content_dir=str(content_dir.resolve()),
            total_urls=len(args.urls),
            ok_count=ok_count,
            error_count=len(args.urls) - ok_count,
            results=manifest_rows,
        )
        sys.stdout.write(_dump_model(manifest))
    except Exception as exc:
        print(f"Error: {exc}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
