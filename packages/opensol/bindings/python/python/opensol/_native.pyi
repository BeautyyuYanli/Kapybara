"""Native Future bridge; public coroutine APIs are defined in opensol.aio.

Native async methods return scheduled awaitables. The aio wrappers create and
await them inside async def, so public calls remain lazy and accept create_task.
"""

import builtins
from collections.abc import Awaitable, Sequence
from typing import Literal, TypedDict

class SdkError(Exception):
    backend: str
    operation: str
    kind: str

class InvalidArgumentError(SdkError): ...
class UnsupportedError(SdkError): ...
class NotFoundError(SdkError): ...
class ConflictError(SdkError): ...
class PermissionError(SdkError): ...
class TimeoutError(SdkError): ...
class TransportError(SdkError): ...
class BackendError(SdkError): ...

class LifecycleCapabilities(TypedDict):
    create: bool
    inspect: bool
    start: bool
    stop: bool
    stop_preserves_memory: bool
    delete: bool
    fork: bool

class ConnectionCapabilities(TypedDict):
    stdin: bool
    timeout: bool
    separate_stderr: bool

class ProcessCapabilities(TypedDict):
    list: bool
    pause: bool
    start: bool
    restart: bool
    kill: bool
    remove: bool
    stdin: bool
    close_stdin: bool
    binary_stdin: bool
    pty: bool
    resize: bool
    supported_signals: builtins.list[Literal[2, 9, 15]]
    detached: bool
    reconnect: bool
    daemon_restart_recovery: bool

class OutputCapabilities(TypedDict):
    read: bool
    tail: bool
    subscribe: bool
    historical_output: bool
    streaming_output: bool

class TerminalCapabilities(TypedDict):
    read: bool
    tail: bool
    screen: bool

class ResourceRef:
    def __init__(self, backend: str, id: str) -> None: ...
    @property
    def backend(self) -> str: ...
    @property
    def id(self) -> str: ...

class ProcessRef:
    def __init__(self, backend: str, id: str, pty: bool | None = None) -> None: ...
    @property
    def backend(self) -> str: ...
    @property
    def id(self) -> str: ...
    @property
    def pty(self) -> bool | None: ...

class ExitStatus:
    @property
    def code(self) -> int | None: ...
    @property
    def signal(self) -> int | None: ...
    @property
    def success(self) -> bool: ...

class ProcessOutcome:
    """Confirmed completion with an exit status, a safe native result name, or both."""
    @property
    def exit(self) -> ExitStatus | None: ...
    @property
    def native_result(self) -> str | None: ...

class ExecResult:
    @property
    def stdout(self) -> bytes: ...
    @property
    def stderr(self) -> bytes: ...
    @property
    def exit(self) -> ExitStatus: ...
    @property
    def exit_code(self) -> int | None: ...
    @property
    def signal(self) -> int | None: ...
    @property
    def success(self) -> bool: ...

class ResourceInfo:
    @property
    def resource(self) -> ResourceRef: ...
    @property
    def state(
        self,
    ) -> Literal["pending", "running", "stopped", "completed", "failed", "unknown"]: ...
    @property
    def native_state(self) -> str: ...

class ProcessInfo:
    @property
    def process(self) -> ProcessRef: ...
    @property
    def state(self) -> Literal["queued", "running", "paused", "exited", "unknown"]: ...
    @property
    def native_state(self) -> str: ...
    @property
    def outcome(self) -> ProcessOutcome | None: ...

class ManagerInfo:
    @property
    def backend(self) -> str: ...
    @property
    def client_version(self) -> str | None: ...
    @property
    def server_version(self) -> str | None: ...

class OutputCursor:
    def __init__(self, value: str) -> None: ...
    @property
    def value(self) -> str: ...
    def __str__(self) -> str: ...

class TerminalCursor:
    def __init__(self, value: str) -> None: ...
    @property
    def value(self) -> str: ...
    def __str__(self) -> str: ...

class OutputChunk:
    @property
    def channel(self) -> Literal["stdout", "stderr", "terminal", "combined"]: ...
    @property
    def data(self) -> bytes: ...

class OutputPage:
    @property
    def chunks(self) -> list[OutputChunk]: ...
    @property
    def before(self) -> OutputCursor | None: ...
    @property
    def after(self) -> OutputCursor | None: ...
    @property
    def at_head(self) -> bool | None: ...
    @property
    def at_tail(self) -> bool: ...

class TerminalPage:
    @property
    def lines(self) -> list[str]: ...
    @property
    def before(self) -> TerminalCursor | None: ...
    @property
    def after(self) -> TerminalCursor | None: ...
    @property
    def at_head(self) -> bool | None: ...
    @property
    def at_tail(self) -> bool: ...

class TerminalScreen:
    @property
    def cols(self) -> int: ...
    @property
    def rows(self) -> int: ...
    @property
    def lines(self) -> list[str]: ...

class Output:
    def capabilities(self) -> OutputCapabilities: ...
    def read(self, *, cursor: OutputCursor | None = None, direction: Literal["forward", "backward"] = "forward", max_bytes: int = 65536) -> OutputPage: ...
    def tail(self, *, max_bytes: int = 65536) -> OutputPage: ...
    def subscribe(self) -> OutputSubscription: ...

class Terminal:
    def capabilities(self) -> TerminalCapabilities: ...
    def read(self, *, cursor: TerminalCursor | None = None, direction: Literal["forward", "backward"] = "forward", lines: int = 200) -> TerminalPage: ...
    def tail(self, *, lines: int = 200) -> TerminalPage: ...
    def screen(self) -> TerminalScreen: ...

class Process:
    @property
    def ref(self) -> ProcessRef: ...
    def inspect(self) -> ProcessInfo: ...
    def wait(self, *, timeout: float | None = None) -> ProcessOutcome: ...
    def pause(self) -> None: ...
    def start(self) -> None: ...
    def restart(self) -> None: ...
    def kill(self) -> None: ...
    def remove(self) -> None: ...
    def signal(self, signal: int) -> None: ...
    def send_input(self, data: bytes) -> None: ...
    def close_stdin(self) -> None: ...
    def resize(self, cols: int, rows: int) -> None: ...

    @property
    def output(self) -> Output: ...
    @property
    def terminal(self) -> Terminal: ...

class Connection:
    @property
    def backend(self) -> str: ...
    def capabilities(self) -> ConnectionCapabilities: ...
    def exec(
        self,
        argv: Sequence[str],
        *,
        cwd: str | None = None,
        env: dict[str, str] | None = None,
        stdin: bytes = b"",
        timeout: float | None = None,
    ) -> ExecResult: ...
    def shell(
        self,
        script: str,
        *,
        cwd: str | None = None,
        env: dict[str, str] | None = None,
        stdin: bytes = b"",
        timeout: float | None = None,
    ) -> ExecResult: ...

class Lifecycle:
    @property
    def backend(self) -> str: ...
    def capabilities(self) -> LifecycleCapabilities: ...
    def create(
        self, *, name: str | None = None, labels: dict[str, str] | None = None
    ) -> ResourceRef: ...
    def inspect(self, resource: ResourceRef) -> ResourceInfo: ...
    def start(self, resource: ResourceRef) -> None: ...
    def stop(self, resource: ResourceRef) -> None: ...
    def delete(self, resource: ResourceRef) -> None: ...
    def fork(self, resource: ResourceRef) -> ResourceRef: ...

class ProcessEvent:
    @property
    def channel(self) -> Literal["stdout", "stderr", "terminal", "combined"] | None: ...
    @property
    def data(self) -> bytes: ...
    @property
    def outcome(self) -> ProcessOutcome | None: ...

class OutputSubscription:
    @property
    def ref(self) -> ProcessRef: ...
    def next_event(self, *, timeout: float | None = None) -> ProcessEvent | None: ...
    def wait(self, *, timeout: float | None = None) -> ProcessOutcome: ...
    def close(self) -> None: ...

class ProcessManager:
    @property
    def backend(self) -> str: ...
    def capabilities(self) -> ProcessCapabilities: ...
    def get(self, process: ProcessRef) -> Process: ...
    def probe(self) -> ManagerInfo: ...
    def list(self) -> list[ProcessInfo]: ...
    def spawn(
        self,
        argv: Sequence[str],
        *,
        cwd: str | None = None,
        env: dict[str, str] | None = None,
        stdin: bool = False,
        pty: tuple[int, int] | None = None,
    ) -> tuple[Process, OutputSubscription]: ...

class Envd:
    @property
    def connection(self) -> Connection: ...
    @property
    def processes(self) -> ProcessManager: ...

class Docker:
    @property
    def lifecycle(self) -> Lifecycle: ...
    def connection(self, resource: ResourceRef) -> Connection: ...

class E2b:
    @property
    def lifecycle(self) -> Lifecycle: ...
    def envd(self, resource: ResourceRef) -> Envd: ...
    def _aio_envd(self, resource: ResourceRef) -> Awaitable[Envd]: ...

class OpenShell:
    @property
    def lifecycle(self) -> Lifecycle: ...
    def connection(self, resource: ResourceRef) -> Connection: ...

class AsyncConnection:
    @property
    def backend(self) -> str: ...
    def capabilities(self) -> ConnectionCapabilities: ...
    def _blocking(self) -> Connection: ...
    def exec(
        self, argv: Sequence[str], *, cwd: str | None = None,
        env: dict[str, str] | None = None, stdin: bytes = b"",
        timeout: float | None = None,
    ) -> Awaitable[ExecResult]: ...
    def shell(
        self, script: str, *, cwd: str | None = None,
        env: dict[str, str] | None = None, stdin: bytes = b"",
        timeout: float | None = None,
    ) -> Awaitable[ExecResult]: ...

class AsyncLifecycle:
    @property
    def backend(self) -> str: ...
    def capabilities(self) -> LifecycleCapabilities: ...
    def create(
        self, *, name: str | None = None, labels: dict[str, str] | None = None,
    ) -> Awaitable[ResourceRef]: ...
    def inspect(self, resource: ResourceRef) -> Awaitable[ResourceInfo]: ...
    def start(self, resource: ResourceRef) -> Awaitable[None]: ...
    def stop(self, resource: ResourceRef) -> Awaitable[None]: ...
    def delete(self, resource: ResourceRef) -> Awaitable[None]: ...
    def fork(self, resource: ResourceRef) -> Awaitable[ResourceRef]: ...

class AsyncOutputSubscription:
    @property
    def ref(self) -> ProcessRef: ...
    def _reserve(self, *, timeout: float | None = None) -> Awaitable[ProcessEvent | None]: ...
    def _commit(self) -> None: ...
    def _outcome(self) -> Awaitable[ProcessOutcome]: ...
    def aclose(self) -> Awaitable[None]: ...

class AsyncProcessManager:
    @property
    def backend(self) -> str: ...
    def capabilities(self) -> ProcessCapabilities: ...
    def get(self, process: ProcessRef) -> AsyncProcess: ...
    def probe(self) -> Awaitable[ManagerInfo]: ...
    def list(self) -> Awaitable[list[ProcessInfo]]: ...
    def spawn(
        self, argv: Sequence[str], *, cwd: str | None = None,
        env: dict[str, str] | None = None, stdin: bool = False,
        pty: tuple[int, int] | None = None,
    ) -> Awaitable[tuple[AsyncProcess, AsyncOutputSubscription]]: ...

class AsyncProcess:
    @property
    def ref(self) -> ProcessRef: ...
    def inspect(self) -> Awaitable[ProcessInfo]: ...
    def wait(self, *, timeout: float | None = None) -> Awaitable[ProcessOutcome]: ...
    def pause(self) -> Awaitable[None]: ...
    def start(self) -> Awaitable[None]: ...
    def restart(self) -> Awaitable[None]: ...
    def kill(self) -> Awaitable[None]: ...
    def remove(self) -> Awaitable[None]: ...
    def signal(self, signal: int) -> Awaitable[None]: ...
    def send_input(self, data: bytes) -> Awaitable[None]: ...
    def close_stdin(self) -> Awaitable[None]: ...
    def resize(self, cols: int, rows: int) -> Awaitable[None]: ...

    @property
    def output(self) -> AsyncOutput: ...
    @property
    def terminal(self) -> AsyncTerminal: ...

class AsyncOutput:
    def capabilities(self) -> OutputCapabilities: ...
    def read(self, *, cursor: OutputCursor | None = None, direction: Literal["forward", "backward"] = "forward", max_bytes: int = 65536) -> Awaitable[OutputPage]: ...
    def tail(self, *, max_bytes: int = 65536) -> Awaitable[OutputPage]: ...
    def subscribe(self) -> Awaitable[AsyncOutputSubscription]: ...

class AsyncTerminal:
    def capabilities(self) -> TerminalCapabilities: ...
    def read(self, *, cursor: TerminalCursor | None = None, direction: Literal["forward", "backward"] = "forward", lines: int = 200) -> Awaitable[TerminalPage]: ...
    def tail(self, *, lines: int = 200) -> Awaitable[TerminalPage]: ...
    def screen(self) -> Awaitable[TerminalScreen]: ...

def _async_connection(connection: Connection) -> AsyncConnection: ...
def _async_lifecycle(lifecycle: Lifecycle) -> AsyncLifecycle: ...
def _async_processes(manager: ProcessManager) -> AsyncProcessManager: ...
def _aio_sandboxd(
    endpoint: str, *, bearer_token: str | None = None,
    ca_certificate: str | None = None, client_certificate: str | None = None,
    client_key: str | None = None,
) -> Awaitable[AsyncConnection]: ...
def _aio_openshell(
    endpoint: str, *, workspace: str = "default", workload_template: str | None = None,
    spec_protobuf: bytes | None = None, bearer_token: str | None = None,
    ca_certificate: str | None = None, client_certificate: str | None = None,
    client_key: str | None = None,
) -> Awaitable[OpenShell]: ...
def _aio_openshell_connection(
    endpoint: str, sandbox: str, *, workspace: str = "default",
    bearer_token: str | None = None, ca_certificate: str | None = None,
    client_certificate: str | None = None, client_key: str | None = None,
) -> Awaitable[AsyncConnection]: ...

def local() -> Connection: ...
def ssh(
    destination: str,
    *,
    port: int | None = None,
    identity_file: str | None = None,
    config_file: str | None = None,
    program: str = "ssh",
) -> Connection: ...
def docker(
    image: str,
    *,
    command: Sequence[str] | None = None,
    env: dict[str, str] | None = None,
    working_dir: str | None = None,
    host_config_json: str | None = None,
) -> Docker: ...
def docker_connection(container: str) -> Connection: ...
def pueue(
    connection: Connection,
    *,
    config_file: str | None = None,
    profile: str | None = None,
    group: str | None = None,
    pueue_directory: str | None = None,
    program: str = "pueue",
) -> ProcessManager: ...
def tmux(
    connection: Connection,
    *,
    socket_path: str,
    session_prefix: str = "opensol",
    program: str = "tmux",
) -> ProcessManager: ...
def envd(
    endpoint: str,
    *,
    access_token: str | None = None,
    user: str | None = None,
    sandbox_id: str | None = None,
    request_timeout: float = 30.0,
) -> Envd: ...
def e2b(
    api_key: str,
    template: str = "base",
    *,
    api_endpoint: str = "https://api.e2b.app",
    sandbox_timeout: int = 300,
    auto_pause: bool = False,
    env: dict[str, str] | None = None,
    metadata: dict[str, str] | None = None,
    envd_endpoint: str | None = None,
    sandbox_domain: str = "e2b.app",
    request_timeout: float = 30.0,
) -> E2b: ...
def agent_sandbox(
    namespace: str,
    pod_template_json: str,
    *,
    context: str | None = None,
    kubeconfig: str | None = None,
    program: str = "kubectl",
    service: bool = True,
    volume_claim_templates_json: str | None = None,
) -> Lifecycle: ...
def sandboxd(
    endpoint: str,
    *,
    bearer_token: str | None = None,
    ca_certificate: str | None = None,
    client_certificate: str | None = None,
    client_key: str | None = None,
) -> Connection: ...
def openshell(
    endpoint: str,
    *,
    workspace: str = "default",
    workload_template: str | None = None,
    spec_protobuf: bytes | None = None,
    bearer_token: str | None = None,
    ca_certificate: str | None = None,
    client_certificate: str | None = None,
    client_key: str | None = None,
) -> OpenShell: ...
def openshell_connection(
    endpoint: str,
    sandbox: str,
    *,
    workspace: str = "default",
    bearer_token: str | None = None,
    ca_certificate: str | None = None,
    client_certificate: str | None = None,
    client_key: str | None = None,
) -> Connection: ...
